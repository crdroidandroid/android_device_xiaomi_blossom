cc_prebuilt_library_shared {
	name: "libui-v32",
	strip: {
	    none: true,
	},
	target: {
	    android_arm: {
		srcs: ["libui-v32.so"],
            },
	},
	compile_multilib: "32",
	check_elf_files: false,
	vendor: true,
}
